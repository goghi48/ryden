# Copy to .env.production and replace every CHANGE_ME value.
# Use a URL-safe PostgreSQL password, or percent-encode it in RYDEN_DATABASE_URL.
POSTGRES_DB=ryden
POSTGRES_USER=ryden
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
RYDEN_DATABASE_URL=postgres://ryden:CHANGE_ME_DATABASE_PASSWORD@postgres:5432/ryden?sslmode=disable

# Generate at least 32 random characters. Do not reuse the database password.
RYDEN_ACCESS_TOKEN_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
RYDEN_ALLOWED_ORIGIN=https://ryden.example.com
RYDEN_WEB_BIND=127.0.0.1
RYDEN_WEB_PORT=8080

# Economical single-instance defaults. Increase only after observing pool saturation.
RYDEN_DATABASE_MAX_CONNS=10
RYDEN_DATABASE_MIN_CONNS=1
RYDEN_DATABASE_CONNECT_TIMEOUT=5s
RYDEN_DATABASE_STATEMENT_TIMEOUT=8s
RYDEN_DATABASE_MAX_CONN_LIFETIME=30m
RYDEN_DATABASE_MAX_CONN_IDLE_TIME=5m
RYDEN_DATABASE_HEALTH_CHECK_PERIOD=1m

# One batched version query per active API instance every two seconds.
RYDEN_LIVE_POLL_INTERVAL=2s
RYDEN_LIVE_POLL_TIMEOUT=1500ms
RYDEN_LIVE_MAX_MEETINGS=1000
RYDEN_LIVE_MAX_SUBSCRIBERS_PER_MEETING=100

# Container guardrails for a small host. Adjust together with measured load.
RYDEN_POSTGRES_MEMORY_LIMIT=768m
RYDEN_POSTGRES_CPUS=1.5
RYDEN_API_MEMORY_LIMIT=384m
RYDEN_API_CPUS=1.0
RYDEN_WEB_MEMORY_LIMIT=128m
RYDEN_WEB_CPUS=0.5
